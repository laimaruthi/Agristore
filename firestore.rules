rules_version = '2';
// SECURITY: previously allowed any authenticated user to read/write every store's
// data. Now defaults to deny. If you re-enable Firebase sync for multi-tenant use,
// replace this block with rules that scope access to the document owner's uid, e.g.:
//
//   match /agristore/users/{uid}/{document=**} {
//     allow read, write: if request.auth != null && request.auth.uid == uid;
//   }
//
// AgriStore currently runs local-only (SQLite). These deny-all rules ensure that if
// the shipped Firebase config keys are ever used, customer data stays inaccessible.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
